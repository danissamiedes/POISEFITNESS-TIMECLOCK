# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). NEVER commit .env.local.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only — full access, bypasses RLS. Used by admin server routes to mint
# signed photo URLs and manage employees. Keep this SECRET (never NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket that holds punch photos (must match supabase/03_policies.sql).
NEXT_PUBLIC_PHOTO_BUCKET=punch-photos
